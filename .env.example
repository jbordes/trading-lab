# TradingLab 2.0
#
# El receptor y el dashboard en modo telemetría comparten este nombre:
TRADINGLAB_TELEMETRY_TOKEN=<generate-an-ephemeral-local-test-token>
TRADINGLAB_DASHBOARD_TOKEN=<generate-a-distinct-dashboard-test-token>
# Agregar aquí solamente nombres, descripción y valores seguros de ejemplo.
# Nunca incluir credenciales, tokens, rutas personales ni valores funcionales.

# Piloto v2: tres credenciales distintas, solo en memoria del proceso.
TRADINGLAB_TELEMETRY_LIVE_TOKEN=<generate-a-v2-live-test-token>
TRADINGLAB_TELEMETRY_ACTIVITY_TOKEN=<generate-a-v2-activity-test-token>
TRADINGLAB_TELEMETRY_READ_TOKEN=<generate-a-v2-read-test-token>
